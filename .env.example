# Application
APP_NAME=Crime Horror Research Engine
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://chre:chre_secret@postgres:5432/chre
DATABASE_URL_SYNC=postgresql://chre:chre_secret@postgres:5432/chre

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Elasticsearch / OpenSearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=chre_articles

# AI / LLM (optional - pipeline works with spaCy fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_PROVIDER=local

# Crawler settings
CRAWLER_USER_AGENT=CHRE-ResearchBot/1.0 (+https://example.com/bot)
CRAWLER_RATE_LIMIT=2
CRAWLER_CONCURRENT_REQUESTS=8
CRAWLER_PROXY_URL=
CRAWLER_RESPECT_ROBOTS=true

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=change-me-32-byte-key-for-fernet!!

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
